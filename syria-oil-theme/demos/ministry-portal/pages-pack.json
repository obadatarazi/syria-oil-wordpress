    "content_html": "<div class=\"grid-2\" style=\"margin-bottom:2rem\">\n  <article class=\"card\"><div class=\"card-body\"><h3>لماذا العمل معنا؟</h3><p class=\"text-muted\" style=\"margin-top:.75rem;line-height:1.8\">بيئة مهنية، برامج تدريب، مسارات ترقية، وتأمين صحي، مع فرص ميدانية ومكتبية.</p></div></article>\n  <article class=\"card\"><div class=\"card-body\"><h3>المزايا</h3><ul class=\"text-muted\" style=\"margin-top:.75rem;line-height:2\"><li>• تطوير مهني مستمر</li><li>• بدل مواقع ميدانية</li><li>• تأمين صحي عائلي</li><li>• ثقافة سلامة أولاً</li></ul></div></article>\n</div>\n<h2 style=\"margin-bottom:1rem\">الوظائف المفتوحة</h2>\n<div class=\"grid-3\" data-render=\"jobs\" style=\"margin-bottom:2.5rem\"></div>\n<h2 id=\"apply\" style=\"margin-bottom:1rem\">نموذج التقديم</h2>\n<form class=\"card\"><div class=\"card-body grid-2\">\n  <div class=\"form-group\"><label class=\"form-label\">الاسم الكامل</label><input class=\"form-control\" required /></div>\n  <div class=\"form-group\"><label class=\"form-label\">البريد الإلكتروني</label><input class=\"form-control\" type=\"email\" required /></div>\n  <div class=\"form-group\"><label class=\"form-label\">المسمى المطلوب</label><select class=\"form-select\"><option>مهندس مكامن</option><option>أخصائي سلامة</option><option>محلل بيانات</option></select></div>\n  <div class=\"form-group\"><label class=\"form-label\">رقم الهاتف</label><input class=\"form-control\" /></div>\n  <div class=\"form-group\" style=\"grid-column:1/-1\"><label class=\"form-label\">نبذة مختصرة</label><textarea class=\"form-textarea\"></textarea></div>\n  <div><button class=\"btn btn-primary\" type=\"submit\">إرسال الطلب</button></div>\n</div></form>"
  },
  "statistics": {
    "title": "الإحصاءات والبيانات المفتوحة",
    "subtitle": "جداول ومؤشرات قابلة للتحميل Excel/PDF.",
    "content_html": "<div style=\"display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem\">\n  <a class=\"btn btn-primary\" href=\"#\">تحميل Excel</a>\n  <a class=\"btn btn-secondary\" href=\"#\">تحميل PDF</a>\n</div>\n<div class=\"grid-4\" style=\"margin-bottom:2rem\">\n  <div class=\"stat-card\"><div class=\"value\">385K</div><div class=\"label\">نفط ب/ي</div></div>\n  <div class=\"stat-card\"><div class=\"value\">18</div><div class=\"label\">غاز مليون م³/يوم</div></div>\n  <div class=\"stat-card\"><div class=\"value\">2.4K</div><div class=\"label\">كم أنابيب</div></div>\n  <div class=\"stat-card\"><div class=\"value\">67%</div><div class=\"label\">امتثال بيئي</div></div>\n</div>\n<div class=\"table-wrap\" style=\"margin-bottom:2rem\">\n<table class=\"data\">\n<thead><tr><th>السنة</th><th>إنتاج النفط</th><th>إنتاج الغاز</th><th>الصادرات</th></tr></thead>\n<tbody>\n<tr><td>2023</td><td>310,000</td><td>14.2</td><td>1.1B</td></tr>\n<tr><td>2024</td><td>342,000</td><td>16.0</td><td>1.4B</td></tr>\n<tr><td>2025</td><td>368,000</td><td>17.1</td><td>1.6B</td></tr>\n<tr><td>2026*</td><td>385,000</td><td>18.0</td><td>1.8B</td></tr>\n</tbody>\n</table>\n</div>\n<div class=\"card\"><div class=\"card-body\">\n  <h3 style=\"margin-bottom:1rem\">مخطط إنتاج مبسّط</h3>\n  <div style=\"display:flex;align-items:end;gap:1rem;height:180px;padding-top:1rem\">\n    <div style=\"flex:1;background:var(--green-100);border-radius:12px 12px 0 0;height:55%;display:grid;place-items:end center;padding:.5rem;font-size:.75rem\">2023</div>\n    <div style=\"flex:1;background:var(--green-100);border-radius:12px 12px 0 0;height:68%;display:grid;place-items:end center;padding:.5rem;font-size:.75rem\">2024</div>\n    <div style=\"flex:1;background:var(--green-100);border-radius:12px 12px 0 0;height:80%;display:grid;place-items:end center;padding:.5rem;font-size:.75rem\">2025</div>\n    <div style=\"flex:1;background:var(--color-primary);color:#fff;border-radius:12px 12px 0 0;height:92%;display:grid;place-items:end center;padding:.5rem;font-size:.75rem\">2026</div>\n  </div>\n</div>"
  },
  "investments": {
    "title": "الاستثمار وفرص الشراكة",
    "subtitle": "حزم استثمارية في الاستكشاف والإنتاج والبنية التحتية.",
    "content_html": "<div class=\"grid-3\">\n  <article class=\"card\"><div class=\"card-body\"><span class=\"badge\">Upstream</span><h3 style=\"margin:1rem 0\">مربعات استكشاف</h3><p class=\"text-muted\" style=\"font-size:.9rem;margin-bottom:1rem\">بيانات أولية، إطار تعاقد، ومسار ترخيص واضح.</p><a class=\"btn btn-primary btn-sm\" href=\"contact.html\">اطلب ملف الفرصة</a></div></article>\n  <article class=\"card\"><div class=\"card-body\"><span class=\"badge\">Midstream</span><h3 style=\"margin:1rem 0\">خطوط النقل</h3><p class=\"text-muted\" style=\"font-size:.9rem;margin-bottom:1rem\">شراكات تأهيل وتشغيل لمقاطع استراتيجية.</p><a class=\"btn btn-primary btn-sm\" href=\"contact.html\">اطلب ملف الفرصة</a></div></article>\n  <article class=\"card\"><div class=\"card-body\"><span class=\"badge\">Downstream</span><h3 style=\"margin:1rem 0\">المصافي</h3><p class=\"text-muted\" style=\"font-size:.9rem;margin-bottom:1rem\">تحديث وحدات ورفع كفاءة وتقليل الانبعاثات.</p><a class=\"btn btn-primary btn-sm\" href=\"contact.html\">اطلب ملف الفرصة</a></div></article>\n</div>"
  },
  "exploration": {
    "title": "الاستكشاف والحقول",
    "subtitle": "المربعات البرية والبحرية، الحقول، والبيانات الجيولوجية.",
    "content_html": "<div class=\"grid-2\" style=\"margin-bottom:2rem\">\n  <article class=\"card\"><div class=\"card-body\"><h3>الاستكشاف البري</h3><p class=\"text-muted\" style=\"margin-top:.75rem;line-height:1.8\">مربعات مفتوحة، متطلبات فنية، وجداول زمنية للتقديم.</p><a class=\"btn btn-secondary btn-sm\" style=\"margin-top:1rem\" href=\"services.html\">طلب استكشاف</a></div></article>\n  <article class=\"card\"><div class=\"card-body\"><h3>الاستكشاف البحري</h3><p class=\"text-muted\" style=\"margin-top:.75rem;line-height:1.8\">دراسات زلزالية وشراكات دولية وفق ضوابط وطنية.</p><a class=\"btn btn-secondary btn-sm\" style=\"margin-top:1rem\" href=\"investments.html\">فرص بحرية</a></div></article>\n</div>\n<div class=\"alert alert-success\">للحصول على حزم البيانات الجيولوجية استخدم خدمة «طلب بيانات جيولوجية» بعد توقيع اتفاقية الاستخدام.</div>"
  },
  "sitemap": {
    "title": "خريطة الموقع",
    "subtitle": "دليل سريع لأهم صفحات البوابة.",
    "content_html": "<div class=\"sitemap-grid\">\n  <div class=\"sitemap-col\">\n    <h3>الموقع</h3>\n    <ul>\n      <li><a href=\"/\">الرئيسية</a></li>\n      <li><a href=\"/about/\">عن الموقع</a></li>\n      <li><a href=\"/faq/\">الأسئلة الشائعة</a></li>\n      <li><a href=\"/sitemap/\">خريطة الموقع</a></li>\n    </ul>\n  </div>\n  <div class=\"sitemap-col\">\n    <h3>الأخبار والمقالات</h3>\n    <ul>\n      <li><a href=\"/news/\">الأخبار</a></li>\n      <li><a href=\"/articles/\">المقالات</a></li>\n      <li><a href=\"/media/\">المركز الإعلامي</a></li>\n      <li><a href=\"/downloads/\">التقارير</a></li>\n    </ul>\n  </div>\n  <div class=\"sitemap-col\">\n    <h3>الخدمات والمشاريع</h3>\n    <ul>\n      <li><a href=\"/services/\">الأقسام</a></li>\n      <li><a href=\"/projects/\">المشاريع</a></li>\n      <li><a href=\"/tenders/\">المناقصات</a></li>\n      <li><a href=\"/investments/\">الاستثمارات</a></li>\n    </ul>\n  </div>\n  <div class=\"sitemap-col\">\n    <h3>تواصل</h3>\n    <ul>\n      <li><a href=\"/contact/\">اتصل بنا</a></li>\n      <li><a href=\"mailto:info@syria-oil.com\">info@syria-oil.com</a></li>\n    </ul>\n  </div>\n</div>"
  },
  "privacy-policy": {
    "title": "سياسة الخصوصية",
    "subtitle": "كيف نتعامل مع بيانات الزوار وما نجمعه وكيف نحميه.",
    "content_html": "<div class=\"card\"><div class=\"card-body\" style=\"line-height:1.9\">\n  <p>تحترم منصة <strong>سيريا أويل</strong> خصوصية زوارها. توضح هذه الصفحة أنواع المعلومات التي قد تُجمع عند استخدام الموقع، وأغراض استخدامها.</p>\n  <h2>البيانات التي قد نجمعها</h2>\n  <ul>\n    <li>بيانات تقنية أساسية مثل عنوان IP ونوع المتصفح وصفحات الزيارة (عبر سجلات الخادم أو أدوات تحليلية).</li>\n    <li>بيانات تقدّمها طواعية عبر نماذج التواصل أو الاشتراك في النشرة البريدية (الاسم والبريد الإلكتروني).</li>\n    <li>ملفات تعريف الارتباط (Cookies) اللازمة لتشغيل الموقع وتحسين التجربة.</li>\n  </ul>\n  <h2>كيف نستخدم البيانات</h2>\n  <ul>\n    <li>تشغيل الموقع وتأمينه وتحسين الأداء.</li>\n    <li>الرد على استفساراتكم وإرسال النشرة عند الاشتراك.</li>\n    <li>فهم اهتمامات القرّاء بشكل مجمّع وغير شخصي قدر الإمكان.</li>\n  </ul>\n  <h2>المشاركة مع طرف ثالث</h2>\n  <p>لا نبيع بياناتكم الشخصية. قد تُشارك بيانات محدودة مع مزوّدي خدمات ضروريين (استضافة، بريد، تحليلات) وفق عقود ومعايير حماية مناسبة.</p>\n  <h2>حقوقكم</h2>\n  <p>يمكنكم طلب الاطلاع على بياناتكم أو تصحيحها أو حذفها عبر صفحة <a href=\"/contact/\">اتصل بنا</a>، مع مراعاة المتطلبات القانونية والتشغيلية.</p>\n  <h2>التحديثات</h2>\n  <p>قد نحدّث هذه السياسة من وقت لآخر. يُعدّ استمرار استخدام الموقع بعد نشر التعديلات موافقة على النسخة المحدّثة.</p>\n  <p class=\"text-muted\">آخر تحديث: أغسطس 2026</p>\n</div></div>"
  }
}
