select id=\"c-subject\" class=\"form-select\" name=\"subject\">\n          <option>استفسار عام</option>\n          <option>خدمة</option>\n          <option>استثمار</option>\n          <option>شكوى</option>\n        </select>\n      </div>\n      <div class=\"form-group contact-form__full\"><label class=\"form-label\" for=\"c-msg\">الرسالة</label><textarea id=\"c-msg\" class=\"form-textarea\" name=\"message\" rows=\"5\" required></textarea></div>\n    </div>\n    <button class=\"btn btn-primary\" type=\"submit\">إرسال</button>\n  </div>\n</form>"
